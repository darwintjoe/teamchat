# The Convex deployment this app talks to. Expo inlines EXPO_PUBLIC_* variables at bundle time.
# Copy to `.env` (or `.env.local`) and adjust. The value below is the development deployment
# created for the v0 build; it is not a secret (every client needs it).
EXPO_PUBLIC_CONVEX_URL=https://adventurous-squirrel-356.convex.cloud
